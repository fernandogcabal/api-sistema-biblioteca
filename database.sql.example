# Example Docker run for local Postgres (no credentials committed)
# Copy to database.sql locally if needed and fill secrets there (do NOT commit).

docker run -d \
  --name postgres-db \
  -e POSTGRES_USER=${DB_USERNAME:-postgres} \
  -e POSTGRES_PASSWORD=${DB_PASSWORD:-} \
  -e POSTGRES_DB=${DB_NAME:-bibliotecadb} \
  -p 5432:5432 \
  -v postgres_data:/var/lib/postgresql/data \
  postgres:15

# Usage:
# - Set DB_USERNAME and DB_PASSWORD in a local .env or shell before running.
# - On each machine keep database.sql local with real values; do not commit it.
